@api = http://127.0.0.1:8081
@keycloak = http://127.0.0.1:8080
@realm = inventory
@clientId = inventory-api

# This is the imported local-only inventory realm user, not the Keycloak
# admin account (which belongs to the master realm).
@username = inventory-user
@password = InventoryUser_2026!

### Health check
GET {{api}}/health
Accept: application/json

### Get Keycloak access token
# Run this request first; authenticated requests read access_token from its response.
# @name login
POST {{keycloak}}/realms/{{realm}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id={{clientId}}&username={{username}}&password={{password}}

### List products
GET {{api}}/api/v1/products
Authorization: Bearer {{login.response.body.$.access_token}}
Accept: application/json

### List products including soft-deleted products
GET {{api}}/api/v1/products?includeDeleted=true
Authorization: Bearer {{login.response.body.$.access_token}}
Accept: application/json

### Get product by ID
GET {{api}}/api/v1/products/1
Authorization: Bearer {{login.response.body.$.access_token}}
Accept: application/json

### List categories
GET {{api}}/api/v1/categories
Authorization: Bearer {{login.response.body.$.access_token}}
Accept: application/json

### Create category
# Run before Create product; the product initially uses this category.
# @name createCategory
POST {{api}}/api/v1/categories
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
  "name": "HTTP test category"
}

### Update category
PUT {{api}}/api/v1/categories/{{createCategory.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
  "name": "HTTP test category (updated)"
}

### Create product
# Run this request before the update and movement requests that use its response ID.
# @name createProduct
POST {{api}}/api/v1/products
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
  "name": "HTTP test product",
  "productCategoryId": {{createCategory.response.body.$.id}}
}

### Update product
PUT {{api}}/api/v1/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
  "name": "HTTP test product (updated)",
  "productCategoryId": 2
}

### Add stock
POST {{api}}/api/v1/movements/add
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
  "productId": {{createProduct.response.body.$.id}},
  "quantity": 5
}

### Remove stock
POST {{api}}/api/v1/movements/remove
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
  "productId": {{createProduct.response.body.$.id}},
  "quantity": 2
}

### List movements
GET {{api}}/api/v1/movements?page=1&pageSize=50
Authorization: Bearer {{login.response.body.$.access_token}}
Accept: application/json

### List movements for the created product
GET {{api}}/api/v1/movements?productId={{createProduct.response.body.$.id}}&page=1&pageSize=50
Authorization: Bearer {{login.response.body.$.access_token}}
Accept: application/json

### Get paginated audit logs
GET {{api}}/api/v1/audit-logs?page=1&pageSize=50
Authorization: Bearer {{login.response.body.$.access_token}}
Accept: application/json

### Soft-delete the created product
# This records a Delete movement with quantity zero and preserves on-hand stock.
DELETE {{api}}/api/v1/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.access_token}}
Accept: application/json

### Delete category
# The created product has been moved to category 2 and soft-deleted above.
DELETE {{api}}/api/v1/categories/{{createCategory.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.access_token}}
Accept: application/json
